          <p class="text-xs text-slate-400">serenitiilovinghomecare@yahoo.com</p>
        </div>
        <div class="text-xs text-slate-500">
          &copy; {new Date().getFullYear()} Serenitii Independent Living. All rights reserved.
        </div>
      </div>
    </footer>

    <!-- Mobile Sticky Call-To-Action Bar -->
    <div class="fixed bottom-0 inset-x-0 bg-[#1E2B4D] text-white border-t border-slate-700/60 p-3 flex items-center justify-between md:hidden z-50 shadow-2xl">
      <div>
        <p class="text-[10px] text-slate-300 font-medium">Have Questions? Call Direct</p>
        <p class="text-xs font-bold text-white">(317) 796-1078</p>
      </div>
      <a href="tel:3177961078" class="bg-[#5C7953] hover:bg-[#4E6746] text-white text-xs font-bold uppercase tracking-wider px-4 py-2 rounded shadow flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24 11.72 11.72 0 003.68.59 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.72 11.72 0 00.59 3.68 1 1 0 01-.24 1.02l-2.23 2.09z"/></svg>
        Call Intake
      </a>
    </div>

    <!-- Interactive Script for Mobile Nav & Referral Toggle -->
    <script>
      // Mobile Drawer Toggle
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
      });

      // Agency / Caseworker Form Fields Toggle
      const roleSelf = document.getElementById('role-self') as HTMLInputElement;
      const roleCaseworker = document.getElementById('role-caseworker') as HTMLInputElement;
      const caseworkerFields = document.getElementById('caseworker-fields');

      function updateRoleFields() {
        if (roleCaseworker?.checked) {
          caseworkerFields?.classList.remove('hidden');
        } else {
          caseworkerFields?.classList.add('hidden');
        }
      }

      roleSelf?.addEventListener('change', updateRoleFields);
      roleCaseworker?.addEventListener('change', updateRoleFields);
    </script>

  </body>
